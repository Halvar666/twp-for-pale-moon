<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="chrome://global/skin/" type="text/css"?>
<!DOCTYPE window SYSTEM "chrome://twpuxp/locale/twp.dtd">
<?xml-stylesheet href="chrome://twpuxp/skin/options.css" type="text/css"?>
<window id="twpuxp-options-window"
        xmlns="http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul"
        title="&options.001;"
        width="610" height="690" minwidth="480" minheight="400" orient="vertical"
        onload="TWPOptions.init();" onunload="TWPUXPCache.close();">
  <script type="application/javascript" src="chrome://twpuxp/content/l10n.js"/>
  <script type="application/javascript" src="chrome://twpuxp/content/languageCatalog.js"/>
  <script type="application/javascript" src="chrome://twpuxp/content/languageMenus.js"/>
  <script type="application/javascript" src="chrome://twpuxp/content/favoriteLanguages.js"/>
  <script type="application/javascript" src="chrome://twpuxp/content/autoRules.js"/>
  <script type="application/javascript" src="chrome://twpuxp/content/persistentCache.js"/>
  <script type="application/javascript" src="chrome://twpuxp/content/shortcutBindings.js"/>
  <script type="application/javascript" src="chrome://twpuxp/content/customDictionary.js"/>
  <script type="application/javascript" src="chrome://twpuxp/content/settingsBackup.js"/>
  <script type="application/javascript" src="chrome://twpuxp/content/options.js"/>
  <vbox flex="1" class="twpuxp-options-body">
    <hbox align="center">
      <image src="chrome://twpuxp/skin/icon-32.png" width="32" height="32"/>
      <vbox flex="1">
        <label value="&options.002;" class="header"/>
        <description>&options.003;</description>
      </vbox>
    </hbox>
    <scrollbox orient="vertical" flex="1" class="twpuxp-options-scroll">
      <vbox class="twpuxp-options-fields">
    <groupbox>
      <caption label="&options.004;"/>
      <grid flex="1"><columns><column/><column flex="1"/></columns><rows>
        <row align="center"><label value="&options.005;" control="twpuxp-option-from"/>
          <menulist id="twpuxp-option-from" flex="1"><menupopup/></menulist></row>
        <row align="center"><label value="&options.006;" control="twpuxp-option-to"/>
          <menulist id="twpuxp-option-to" flex="1"><menupopup/></menulist></row>
      </rows></grid>
      <hbox><button label="&options.007;" oncommand="TWPOptions.swap();"/></hbox>
      <description class="helptext">&options.008;</description>
    </groupbox>
    <groupbox>
      <caption label="&options.066;"/>
      <description class="helptext">&options.067;</description>
      <grid><columns><column/><column flex="1"/></columns><rows>
        <row align="center"><label value="1." control="twpuxp-option-favorite1"/>
          <menulist id="twpuxp-option-favorite1" flex="1"><menupopup/></menulist></row>
        <row align="center"><label value="2." control="twpuxp-option-favorite2"/>
          <menulist id="twpuxp-option-favorite2" flex="1"><menupopup/></menulist></row>
        <row align="center"><label value="3." control="twpuxp-option-favorite3"/>
          <menulist id="twpuxp-option-favorite3" flex="1"><menupopup/></menulist></row>
      </rows></grid>
    </groupbox>
    <groupbox>
      <caption label="&options.068;"/>
      <description class="helptext">&options.069;</description>
      <textbox id="twpuxp-option-dictionary" multiline="true" rows="5" flex="1"/>
      <description class="helptext">&options.070;</description>
    </groupbox>
    <groupbox>
      <caption label="&options.009;"/>
      <hbox align="center" id="twpuxp-service-row">
      <menulist id="twpuxp-option-service" flex="1" oncommand="TWPOptions.serviceChanged();">
        <menupopup>
          <menuitem value="google" label="&options.010;"/>
          <menuitem value="bing" label="&options.011;"/>
          <menuitem value="deepl" label="&options.012;"/>
        </menupopup>
      </menulist>
      </hbox>
      <description class="helptext">&options.013;</description>
    </groupbox>
    <groupbox>
      <caption label="&options.014;"/>
      <checkbox id="twpuxp-option-privacy" label="&options.015;"/>
      <description class="helptext">&options.016;</description>
      <description class="helptext">&options.017;</description>
    </groupbox>
    <groupbox>
      <caption label="&options.018;"/>
      <checkbox id="twpuxp-option-autoenabled" label="&options.019;"/>
      <description class="helptext">&options.020;</description>
      <label value="&options.021;" control="twpuxp-option-autosites"/>
      <textbox id="twpuxp-option-autosites" multiline="true" rows="3" flex="1"/>
      <label value="&options.022;" control="twpuxp-option-neversites"/>
      <textbox id="twpuxp-option-neversites" multiline="true" rows="3" flex="1"/>
      <label value="&options.023;" control="twpuxp-option-autolangs"/>
      <textbox id="twpuxp-option-autolangs" multiline="true" rows="2" flex="1"/>
      <label value="&options.024;" control="twpuxp-option-neverlangs"/>
      <textbox id="twpuxp-option-neverlangs" multiline="true" rows="2" flex="1"/>
      <description class="helptext">&options.025;</description>
    </groupbox>
    <groupbox>
      <caption label="&options.026;"/>
      <checkbox id="twpuxp-option-diskcache" label="&options.027;"/>
      <description class="helptext">&options.028;</description>
      <hbox align="center">
        <button id="twpuxp-option-cacheclear" label="&options.029;" oncommand="TWPOptions.clearCache();"/>
        <label id="twpuxp-option-cachecount" value=""/>
      </hbox>
    </groupbox>
    <groupbox>
      <caption label="&options.030;"/>
      <description class="helptext">&options.031;</description>
      <checkbox id="twpuxp-option-backupkey" label="&options.032;"/>
      <hbox align="center">
        <button id="twpuxp-option-export" label="&options.033;" oncommand="TWPOptions.exportSettings();"/>
        <button id="twpuxp-option-import" label="&options.034;" oncommand="TWPOptions.importSettings();"/>
      </hbox>
      <description id="twpuxp-option-backupstatus" class="helptext" value=""/>
    </groupbox>
    <groupbox>
      <caption label="&options.035;"/>
      <checkbox id="twpuxp-option-shortcuts" label="&options.036;"/>
      <grid flex="1"><columns><column/><column flex="1"/><column/><column/></columns><rows>
        <row align="center"><label value="&options.037;" control="twpuxp-shortcut-input-toggle"/>
          <textbox id="twpuxp-shortcut-input-toggle" readonly="true" flex="1"
                   tooltiptext="&options.038;"
                   onkeydown="TWPOptions.captureShortcut(event, 'toggle');"/>
          <button label="&options.039;" oncommand="TWPOptions.clearShortcut('toggle');"/>
          <button label="&options.040;" oncommand="TWPOptions.resetShortcut('toggle');"/></row>
        <row align="center"><label value="&options.041;" control="twpuxp-shortcut-input-selection"/>
          <textbox id="twpuxp-shortcut-input-selection" readonly="true" flex="1"
                   tooltiptext="&options.042;"
                   onkeydown="TWPOptions.captureShortcut(event, 'selection');"/>
          <button label="&options.043;" oncommand="TWPOptions.clearShortcut('selection');"/>
          <button label="&options.044;" oncommand="TWPOptions.resetShortcut('selection');"/></row>
        <row align="center"><label value="&options.045;" control="twpuxp-shortcut-input-restore"/>
          <textbox id="twpuxp-shortcut-input-restore" readonly="true" flex="1"
                   tooltiptext="&options.046;"
                   onkeydown="TWPOptions.captureShortcut(event, 'restore');"/>
          <button label="&options.047;" oncommand="TWPOptions.clearShortcut('restore');"/>
          <button label="&options.048;" oncommand="TWPOptions.resetShortcut('restore');"/></row>
      </rows></grid>
      <description id="twpuxp-shortcut-error" class="error" value=""/>
      <description class="helptext">&options.049;</description>
      <description class="helptext">&options.050;</description>
    </groupbox>
    <groupbox>
      <caption label="&options.051;"/>
      <checkbox id="twpuxp-option-dynamic" label="&options.052;"/>
      <checkbox id="twpuxp-option-attributes" label="&options.053;"/>
      <checkbox id="twpuxp-option-iframes" label="&options.054;"/>
      <checkbox id="twpuxp-option-grouped" label="&options.055;"/>
      <checkbox id="twpuxp-option-progress" label="&options.056;"/>
      <description class="helptext">&options.057;</description>
      <checkbox id="twpuxp-option-hover" label="&options.058;"/>
      <description class="helptext">&options.059;</description>
      <grid><columns><column/><column flex="1"/></columns><rows>
        <row align="center"><label value="&options.060;" control="twpuxp-option-concurrency"/>
          <textbox id="twpuxp-option-concurrency" size="6"/></row>
        <row align="center"><label value="&options.061;" control="twpuxp-option-batch"/>
          <textbox id="twpuxp-option-batch" size="6"/></row>
        <row align="center"><label value="&options.062;" control="twpuxp-option-maxnodes"/>
          <textbox id="twpuxp-option-maxnodes" size="8"/></row>
      </rows></grid>
      <description class="helptext">&options.063;</description>
    </groupbox>
      </vbox>
    </scrollbox>
    <description id="twpuxp-options-error" class="error"/>
    <hbox align="center" pack="end" class="twpuxp-options-footer">
      <button label="&options.064;" oncommand="window.close();"/>
      <button id="twpuxp-option-save" label="&options.065;" default="true"
              oncommand="TWPOptions.save();"/>
    </hbox>
  </vbox>
</window>
