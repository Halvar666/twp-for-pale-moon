<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="chrome://global/skin/" type="text/css"?>
<?xml-stylesheet href="chrome://twpuxp/skin/options.css" type="text/css"?>
<window id="twpuxp-options-window"
        xmlns="http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul"
        title="TWP for Pale Moon – Preferences"
        width="610" height="690" minwidth="480" minheight="400" orient="vertical"
        onload="TWPOptions.init();" onunload="TWPUXPCache.close();">
  <script type="application/javascript" src="chrome://twpuxp/content/languageCatalog.js"/>
  <script type="application/javascript" src="chrome://twpuxp/content/languageMenus.js"/>
  <script type="application/javascript" src="chrome://twpuxp/content/autoRules.js"/>
  <script type="application/javascript" src="chrome://twpuxp/content/persistentCache.js"/>
  <script type="application/javascript" src="chrome://twpuxp/content/shortcutBindings.js"/>
  <script type="application/javascript" src="chrome://twpuxp/content/options.js"/>
  <vbox flex="1" class="twpuxp-options-body">
    <hbox align="center">
      <image src="chrome://twpuxp/skin/icon-32.png" width="32" height="32"/>
      <vbox flex="1">
        <label value="TWP for Pale Moon" class="header"/>
        <description>Native UXP translation preferences</description>
      </vbox>
    </hbox>
    <scrollbox orient="vertical" flex="1" class="twpuxp-options-scroll">
      <vbox class="twpuxp-options-fields">
    <groupbox>
      <caption label="Default translation languages"/>
      <grid flex="1"><columns><column/><column flex="1"/></columns><rows>
        <row align="center"><label value="Source language" control="twpuxp-option-from"/>
          <menulist id="twpuxp-option-from" flex="1"><menupopup/></menulist></row>
        <row align="center"><label value="Target language" control="twpuxp-option-to"/>
          <menulist id="twpuxp-option-to" flex="1"><menupopup/></menulist></row>
      </rows></grid>
      <hbox><button label="Swap languages" oncommand="TWPOptions.swap();"/></hbox>
      <description class="helptext">The toolbar button translates the current page using these languages.</description>
    </groupbox>
    <groupbox>
      <caption label="Translation service"/>
      <menulist id="twpuxp-option-service" flex="1" oncommand="TWPOptions.serviceChanged();">
        <menupopup>
          <menuitem value="google" label="Google Translate (default)"/>
          <menuitem value="bing" label="Bing Translator"/>
          <menuitem value="deepl" label="DeepL (experimental, unofficial)"/>
        </menupopup>
      </menulist>
      <description class="helptext">Service applies to pages and selected text. All three services use unofficial endpoints; DeepL one-shot availability can change.</description>
    </groupbox>
    <groupbox>
      <caption label="Privacy and network requests"/>
      <checkbox id="twpuxp-option-privacy" label="Privacy-enhanced translation requests (recommended)"/>
      <description class="helptext">Uses HTTPS and protected XPCOM requests for Google, Bing and DeepL, including Google's token lookup. Suppresses browser cookies and stored login credentials and clears the channel referrer. If protection cannot be applied, the request is blocked rather than sent unprotected. This is privacy protection, not anonymity.</description>
      <description class="helptext">The selected service still receives the text and your network IP address (or VPN/proxy IP). This does not guarantee removal of every network fingerprint or Origin header. Authenticated HTTP proxies may require this option to be switched off.</description>
    </groupbox>
    <groupbox>
      <caption label="Automatic translation rules"/>
      <checkbox id="twpuxp-option-autoenabled" label="Enable automatic translation on matching sites or languages"/>
      <description class="helptext">Rules apply when a web page opens or you switch tabs. Manual translation is always available.</description>
      <label value="Always translate these sites (one hostname per line)" control="twpuxp-option-autosites"/>
      <textbox id="twpuxp-option-autosites" multiline="true" rows="3" flex="1"/>
      <label value="Never auto-translate these sites (takes precedence)" control="twpuxp-option-neversites"/>
      <textbox id="twpuxp-option-neversites" multiline="true" rows="3" flex="1"/>
      <label value="Always translate these page languages (codes, e.g. en, de, sk)" control="twpuxp-option-autolangs"/>
      <textbox id="twpuxp-option-autolangs" multiline="true" rows="2" flex="1"/>
      <label value="Never auto-translate these page languages (codes, e.g. en, de)" control="twpuxp-option-neverlangs"/>
      <textbox id="twpuxp-option-neverlangs" multiline="true" rows="2" flex="1"/>
      <description class="helptext">Domain rules match the site and subdomains. Language rules need a declared page language (html lang or metadata). Site and language exclusions take precedence over all automatic rules. Manual translation is never blocked.</description>
    </groupbox>
    <groupbox>
      <caption label="Local translation cache"/>
      <checkbox id="twpuxp-option-diskcache" label="Store translations in my Pale Moon profile (optional)"/>
      <description class="helptext">May store text from visited websites, including personal content. Disabled by default; never used in private windows. Turning this option off does not delete existing entries.</description>
      <hbox align="center">
        <button id="twpuxp-option-cacheclear" label="Clear stored translations" oncommand="TWPOptions.clearCache();"/>
        <label id="twpuxp-option-cachecount" value=""/>
      </hbox>
    </groupbox>
    <groupbox>
      <caption label="Keyboard shortcuts"/>
      <checkbox id="twpuxp-option-shortcuts" label="Enable TWP keyboard shortcuts"/>
      <grid flex="1"><columns><column/><column flex="1"/><column/><column/></columns><rows>
        <row align="center"><label value="Translate / restore page" control="twpuxp-shortcut-input-toggle"/>
          <textbox id="twpuxp-shortcut-input-toggle" readonly="true" flex="1"
                   tooltiptext="Click and press a key combination; Esc cancels, Delete clears"
                   onkeydown="TWPOptions.captureShortcut(event, 'toggle');"/>
          <button label="Clear" oncommand="TWPOptions.clearShortcut('toggle');"/>
          <button label="Default" oncommand="TWPOptions.resetShortcut('toggle');"/></row>
        <row align="center"><label value="Translate selection" control="twpuxp-shortcut-input-selection"/>
          <textbox id="twpuxp-shortcut-input-selection" readonly="true" flex="1"
                   tooltiptext="Click and press a key combination; Esc cancels, Delete clears"
                   onkeydown="TWPOptions.captureShortcut(event, 'selection');"/>
          <button label="Clear" oncommand="TWPOptions.clearShortcut('selection');"/>
          <button label="Default" oncommand="TWPOptions.resetShortcut('selection');"/></row>
        <row align="center"><label value="Restore original" control="twpuxp-shortcut-input-restore"/>
          <textbox id="twpuxp-shortcut-input-restore" readonly="true" flex="1"
                   tooltiptext="Click and press a key combination; Esc cancels, Delete clears"
                   onkeydown="TWPOptions.captureShortcut(event, 'restore');"/>
          <button label="Clear" oncommand="TWPOptions.clearShortcut('restore');"/>
          <button label="Default" oncommand="TWPOptions.resetShortcut('restore');"/></row>
      </rows></grid>
      <description id="twpuxp-shortcut-error" class="error" value=""/>
      <description class="helptext">Click a shortcut field and press your combination. Esc cancels recording; Delete or Clear disables that action. Use Default to restore its original binding. Save changes with OK.</description>
      <description class="helptext">System and browser shortcuts may take precedence (for example, KDE Ctrl+Alt+T). These conflicts cannot be detected automatically.</description>
    </groupbox>
    <groupbox>
      <caption label="Page translation"/>
      <checkbox id="twpuxp-option-dynamic" label="Translate dynamically loaded content"/>
      <checkbox id="twpuxp-option-attributes" label="Translate HTML labels and attributes (alt, title, placeholder, aria-label)"/>
      <checkbox id="twpuxp-option-iframes" label="Translate accessible same-origin frames (iframe)"/>
      <checkbox id="twpuxp-option-grouped" label="Group text by paragraph (TWP engine)"/>
      <checkbox id="twpuxp-option-progress" label="Show on-page translation progress notices"/>
      <description class="helptext">Off by default. Translation progress remains available in the toolbar popup; important errors are always shown on the page.</description>
      <checkbox id="twpuxp-option-hover" label="Show original text on hover after translation"/>
      <description class="helptext">Original text appears in a small tooltip without altering the translated page. Also available in the toolbar popup.</description>
      <grid><columns><column/><column flex="1"/></columns><rows>
        <row align="center"><label value="Parallel requests (1–6)" control="twpuxp-option-concurrency"/>
          <textbox id="twpuxp-option-concurrency" size="6"/></row>
        <row align="center"><label value="Groups per request (1–20)" control="twpuxp-option-batch"/>
          <textbox id="twpuxp-option-batch" size="6"/></row>
        <row align="center"><label value="Text node limit (0 = unlimited)" control="twpuxp-option-maxnodes"/>
          <textbox id="twpuxp-option-maxnodes" size="8"/></row>
      </rows></grid>
      <description class="helptext">DeepL is experimental and may require future protocol updates. Yandex is not implemented yet.</description>
    </groupbox>
      </vbox>
    </scrollbox>
    <description id="twpuxp-options-error" class="error"/>
    <hbox align="center" pack="end" class="twpuxp-options-footer">
      <button label="Cancel" oncommand="window.close();"/>
      <button id="twpuxp-option-save" label="Save preferences" default="true"
              oncommand="TWPOptions.save();"/>
    </hbox>
  </vbox>
</window>
